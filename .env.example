# ==================================================
# 3D Atlas — Environment Variables
# ==================================================
# Copy this file to .env.local and fill in actual values.
# NEVER commit .env.local to version control.

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="3D Atlas"
NEXT_PUBLIC_APP_DESCRIPTION="A cinematic, scroll-driven 3D web experience."

# ─── Analytics ───────────────────────────────────────────────────────────────
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_VERCEL_ANALYTICS=true

# ─── CMS / Data Layer ────────────────────────────────────────────────────────
# NEXT_PUBLIC_SANITY_PROJECT_ID=
# NEXT_PUBLIC_SANITY_DATASET=production
# SANITY_API_TOKEN=

# ─── Performance ─────────────────────────────────────────────────────────────
# NEXT_PUBLIC_ENABLE_PERF_METRICS=false
